# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Dealing Desk Email Ingestion (Recipient for contact form submissions)
DEALING_INQUIRY_RECIPIENT_EMAIL=hello@bytesbrick.com

# SMTP Server Configuration (Required for live outbound email dispatch)
# Compatible with Gmail, Amazon SES, SendGrid, Brevo, Postmark, or custom SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=hello@bytesbrick.com
SMTP_PASS=your-secure-app-password
SMTP_FROM="Private Market Dealing Desk" <hello@bytesbrick.com>